// Realtime Database rules for the SPL wind logger.
//
// Paste these into Firebase console -> Realtime Database -> Rules, replacing
// DEVICE_UID with the UID of the Authentication user the board signs in as
// (Authentication -> Users, the account's UID column).
//
// Anyone may read /live and /history, which is what lets the hosted dashboard
// work with no API key in the page. The board account may write readings.
// Accounts listed under /admins may delete history only; they cannot inject or
// alter measurements. Everything outside these paths is shut.
{
  "rules": {
    ".read": false,
    ".write": false,

    "live": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'rPzd5TLL2oVvHd4E8lS4mSYBcqn1'"
    },

    "history": {
      ".read": true,
      "$slot": {
        ".write": "auth != null && (auth.uid === 'rPzd5TLL2oVvHd4E8lS4mSYBcqn1' || (root.child('admins').child(auth.uid).val() === true && !newData.exists()))"
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
