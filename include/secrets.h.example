#pragma once

// Copy this file to include/secrets.h and enter your own values.
// Never publish or commit the completed secrets.h file.

constexpr char WIFI_SSID[] = "YOUR_WIFI_NAME";
constexpr char WIFI_PASSWORD[] = "YOUR_WIFI_PASSWORD";

// --- Firebase ---------------------------------------------------------------
// From the Firebase console:
//   Web API key      Project settings -> General -> Web API key
//   Database URL     Realtime Database -> Data (the https://... shown above the
//                    tree), with no trailing slash
//   Device account   Authentication -> Users -> Add user. Make one account that
//                    belongs to this board only, and paste its UID into
//                    firebase/database.rules.json so nothing else can write.
//
// The password is placed into a JSON body as-is, so avoid double quotes and
// backslashes in it.
constexpr char FIREBASE_WEB_API_KEY[] = "YOUR_FIREBASE_WEB_API_KEY";
constexpr char FIREBASE_DATABASE_URL[] =
    "https://YOUR-PROJECT-default-rtdb.YOUR-REGION.firebasedatabase.app";
constexpr char FIREBASE_DEVICE_EMAIL[] = "logger@example.com";
constexpr char FIREBASE_DEVICE_PASSWORD[] = "YOUR_DEVICE_ACCOUNT_PASSWORD";
